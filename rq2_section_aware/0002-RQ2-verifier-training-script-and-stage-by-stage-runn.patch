@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+# RQ2 end-to-end, one stage at a time:   bash run_all_rq2.sh <stage>
+# Stages stop wherever a person must review a sheet. Every stage is resumable (rerun = continue).
+#
+#   setup      venv + requirements + check the generator server
+#   prep       build data, plant candidates (dev auto-accepted; test1 -> REVIEW), MedlinePlus corpus
+#   merge      merge reviewed test1 planted errors, mask doctor A/P in dev + test1 (-> REVIEW mask audit)
+#   traindata  verifier training pairs from ACI train (train split only)
+#   train      QLoRA verifier (GPU)
+#   dev        all RQ2 conditions on dev                     (GPU verifier + generator server)
+#   tune       dev thresholds + dev table (pick K_REF, K_TURN, then set them in rq2.env)
+#   test       conditions on test1 with the chosen k
+#   eval       test1 report + per-step annotation sheet (-> REVIEW steps sheet)
+#   steps      score the filled per-step sheet
+#   smoke      offline plumbing test with stub models
+set -Eeuo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")"
+[[ -f rq2.env ]] && source rq2.env
+PY=${PY:-.venv/bin/python}
+K_REF=${K_REF:-3}
+K_TURN=${K_TURN:-5}
+V=${VERIFIER_NAME:-hf}
+
+pause() { echo; echo ">>> REVIEW NEEDED: $*"; echo ">>> then run: bash run_all_rq2.sh $NEXT"; exit 0; }
+
+conds_dev() {
+  for S in preap full; do
+    $PY run_rq2.py --condition U1 --split dev --setting $S
+    $PY run_rq2.py --condition U2 --split dev --setting $S
+    $PY run_rq2.py --condition U3 --split dev --setting $S
+  done
+  for k in 1 3 5; do
+    $PY run_rq2.py --condition U2 --split dev --evidence topk --k $k
+    $PY run_rq2.py --condition U4 --split dev --k $k
+  done
+  $PY run_rq2.py --condition U4 --split dev --setting full --k $K_REF
+  LINKER=retrieval $PY run_rq2.py --condition U3 --split dev
+  LINKER=retrieval $PY run_rq2.py --condition U4 --split dev --k $K_REF
+}
+
+conds_test() {
+  for S in preap full; do
+    $PY run_rq2.py --condition U1 --split test1 --setting $S
+    $PY run_rq2.py --condition U2 --split test1 --setting $S
+    $PY run_rq2.py --condition U3 --split test1 --setting $S
+    $PY run_rq2.py --condition U4 --split test1 --setting $S --k $K_REF
+  done
+  $PY run_rq2.py --condition U2 --split test1 --evidence topk --k $K_TURN
+  LINKER=retrieval $PY run_rq2.py --condition U3 --split test1
+  LINKER=retrieval $PY run_rq2.py --condition U4 --split test1 --k $K_REF
+}
+
+case "${1:-}" in
+  setup)
+    [[ -x .venv/bin/python ]] || python3 -m venv .venv
+    .venv/bin/python -m pip install -q --upgrade pip
+    .venv/bin/python -m pip install -q -r requirements.txt
+    curl -sf "${GEN_BASE_URL%/v1}/health" && echo || { echo "generator server not reachable at $GEN_BASE_URL"; exit 1; }
+    echo "setup ok" ;;
+  prep)
+    NEXT=merge
+    $PY build_dataset.py --splits train dev test1
+    $PY plant_errors.py --split dev && $PY plant_errors.py --split dev --merge --accept-all
+    $PY plant_errors.py --split test1
+    $PY medlineplus.py
+    pause "data_out/planted_candidates_test1.csv (approved=1/0, two people) and data_out/audit_valid_test1.csv (valid_ok, section_ok)" ;;
+  merge)
+    NEXT=traindata
+    $PY plant_errors.py --split test1 --merge
+    $PY mask_ap.py --split dev
+    $PY mask_ap.py --split test1
+    pause "data_out/mask_audit_test1.csv: spot-check ~10 encounters (rerun mask_ap.py --split X --redo if many are wrong)" ;;
+  traindata)
+    $PY plant_errors.py --split train && $PY plant_errors.py --split train --merge --accept-all
+    $PY mask_ap.py --split train
+    FEATURE_GROUNDING=off $PY make_chain_training_data.py ;;
+  train)
+    $PY train_verifier.py --data data_out/chain_train.jsonl --out models/verifier_qlora ${TRAIN_FLAGS:-} ;;
+  dev)   conds_dev ;;
+  tune)
+    $PY evaluate_rq2.py --split dev --tune
+    $PY evaluate_rq2.py --split dev --setting full
+    echo ">>> pick K_REF (U4 k) and K_TURN (U2 top-k) from reports/dev/metrics.md, set them in rq2.env" ;;
+  test)  conds_test ;;
+  eval)
+    NEXT=steps
+    $PY evaluate_rq2.py --split test1 --setting preap
+    $PY evaluate_rq2.py --split test1 --setting full
+    $PY annotate_steps.py export --split test1 --run U4_preap_ref${K_REF}_link-llm_${V} --n 60
+    pause "data_out/steps_test1_U4_preap_ref${K_REF}_link-llm_${V}.csv: fill the 'gold' column" ;;
+  steps)
+    $PY annotate_steps.py score --split test1 --run U4_preap_ref${K_REF}_link-llm_${V} \
+        --turn-run U2_preap_top${K_TURN}_${V} ;;
+  smoke) bash tests/smoke_test.sh ;;
+  *) sed -n 2,17p "$0"; exit 1 ;;
+esac
diff --git a/rq2_section_aware/train_verifier.py b/rq2_section_aware/train_verifier.py
new file mode 100644
index 0000000..7b713b3
--- /dev/null
+++ b/rq2_section_aware/train_verifier.py
@@ -0,0 +1,112 @@
+"""QLoRA fine-tuning of the verifier (Qwen2.5-3B-Instruct, LoRA rank 16) on {"messages", "target"} JSONL.
+
+Inputs use the SAME prompt builders as inference (prompts.py), so label probabilities at test time
+are meaningful. Loss is computed on the label tokens (+ end-of-turn) only.
+
+  python train_verifier.py --data data_out/chain_train.jsonl --out models/verifier_qlora
+  python train_verifier.py --data data_out/chain_train.jsonl data_out/so_train.jsonl --out models/verifier_qlora
+  # 1080 Ti without 4-bit support in bitsandbytes: add --no-4bit (plain LoRA on fp16 weights, ~7 GB)
+
+S/O pairs (if you build them) must look like: {"messages": prompts.entail_messages(evidence, claim), "target": "supported"}.
+Encounters are split 90/10 into train / held-out (by encounter_id) and held-out label accuracy is printed.
+"""
+import argparse
+import random
+
+import config as C
+from common import read_jsonl
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", nargs="+", required=True)
+    ap.add_argument("--out", default=str(C.ROOT / "models" / "verifier_qlora"))
+    ap.add_argument("--base", default=C.VERIFIER_BASE_MODEL)
+    ap.add_argument("--epochs", type=float, default=2)
+    ap.add_argument("--lr", type=float, default=2e-4)
+    ap.add_argument("--rank", type=int, default=16)
+    ap.add_argument("--max-len", type=int, default=3072)
+    ap.add_argument("--grad-accum", type=int, default=16)
+    ap.add_argument("--no-4bit", action="store_true")
+    a = ap.parse_args()
+
+    import torch
+    from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training
+    from transformers import (AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig, Trainer,
+                              TrainingArguments)
+
+    rows = [r for p in a.data for r in read_jsonl(p)]
+    encs = sorted({r.get("encounter_id", str(i)) for i, r in enumerate(rows)})
+    random.Random(C.SEED).shuffle(encs)
+    held = set(encs[: max(1, len(encs) // 10)])
+    train = [r for i, r in enumerate(rows) if r.get("encounter_id", str(i)) not in held]
+    dev = [r for i, r in enumerate(rows) if r.get("encounter_id", str(i)) in held]
+    print(f"train {len(train)}  held-out {len(dev)}  labels {sorted({r['target'] for r in rows})}")
+
+    tok = AutoTokenizer.from_pretrained(a.base)
+    tok.pad_token = tok.pad_token or tok.eos_token
+    end = tok.eos_token if "<|im_end|>" not in tok.get_vocab() else "<|im_end|>"
+
+    def encode(r):
+        prompt = tok.apply_chat_template(r["messages"], tokenize=False, add_generation_prompt=True)
+        p = tok(prompt, add_special_tokens=False)["input_ids"]
+        t = tok(r["target"] + end, add_special_tokens=False)["input_ids"]
+        if len(p) + len(t) > a.max_len:  # same truncation rule as verifier.HFVerifier
+            keep = a.max_len - len(t)
+            p = p[:64] + p[-(keep - 64):]
+        return {"input_ids": p + t, "labels": [-100] * len(p) + t}
+
+    train_ds = [encode(r) for r in train]
+
+    def collate(batch):
+        n = max(len(b["input_ids"]) for b in batch)
+        ids = torch.full((len(batch), n), tok.pad_token_id)
+        lab = torch.full((len(batch), n), -100)
+        att = torch.zeros((len(batch), n), dtype=torch.long)
+        for i, b in enumerate(batch):
+            L = len(b["input_ids"])
+            ids[i, :L], lab[i, :L], att[i, :L] = torch.tensor(b["input_ids"]), torch.tensor(b["labels"]), 1
+        return {"input_ids": ids, "labels": lab, "attention_mask": att}
+
+    kw = {"device_map": "auto"}
+    if a.no_4bit:
+        kw["torch_dtype"] = torch.float16
+    else:
+        kw["quantization_config"] = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type="nf4",
+                                                       bnb_4bit_compute_dtype=torch.float16,
+                                                       bnb_4bit_use_double_quant=True)
+    model = AutoModelForCausalLM.from_pretrained(a.base, **kw)
+    if not a.no_4bit:
+        model = prepare_model_for_kbit_training(model, use_gradient_checkpointing=True)
+    else:
+        model.gradient_checkpointing_enable()
+        model.enable_input_require_grads()
+    model = get_peft_model(model, LoraConfig(r=a.rank, lora_alpha=2 * a.rank, lora_dropout=0.05, task_type="CAUSAL_LM",
+                                             target_modules=["q_proj", "k_proj", "v_proj", "o_proj",
+                                                             "gate_proj", "up_proj", "down_proj"]))
+    model.print_trainable_parameters()
+    args = TrainingArguments(output_dir=a.out, per_device_train_batch_size=1, gradient_accumulation_steps=a.grad_accum,
+                             num_train_epochs=a.epochs, learning_rate=a.lr, lr_scheduler_type="cosine",
+                             warmup_ratio=0.03, logging_steps=10, save_strategy="epoch", save_total_limit=1,
+                             fp16=True, bf16=False,  # Pascal / Turing: no bf16
+                             report_to=[], remove_unused_columns=False, seed=C.SEED)
+    Trainer(model=model, args=args, train_dataset=train_ds, data_collator=collate).train()
+    model.save_pretrained(a.out)
+    tok.save_pretrained(a.out)
+    print("adapter saved ->", a.out)
+
+    # held-out label accuracy with the exact inference scorer
+    if dev:
+        del model
+        torch.cuda.empty_cache()
+        from verifier import HFVerifier
+        v = HFVerifier(base=a.base, adapter=a.out, load_4bit=not a.no_4bit)
+        ok = 0
+        for r in dev:
+            labels = C.LABELS_CHAIN if r["target"] in C.LABELS_CHAIN else C.LABELS_ENTAIL
+            ok += v.score(r["messages"], labels)["label"] == r["target"]
+        print(f"held-out accuracy {ok / len(dev):.3f} on {len(dev)} examples")
+
+
+if __name__ == "__main__":
+    main()
