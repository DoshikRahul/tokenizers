# Copy to rq2.env and edit:   cp rq2.env.example rq2.env
# Sourced by run_all_rq2.sh. rq2.env is git-ignored (it holds the API key).

# ---- generator LLM = Qwen3-14B host.py (planting, masking, features, links)
export GEN_BASE_URL=http://127.0.0.1:8000/v1     # via SSH tunnel to the server node, see README
export GEN_MODEL=Qwen3-14B
export GEN_API_KEY=                               # MODEL_API_KEY of the server, if one was set
export GEN_JSON_MODE=1                            # host.py validates JSON objects
export GEN_MAX_TOKENS=2048

# ---- verifier (U2-U4): local QLoRA adapter
export VERIFIER_BACKEND=hf
export VERIFIER_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
export VERIFIER_ADAPTER=models/verifier_qlora
export VERIFIER_4BIT=1                            # set 0 if bitsandbytes 4-bit fails on the GPU
export VERIFIER_NAME=hf
# TRAIN_FLAGS=--no-4bit                           # same fallback for training

# ---- U1 decomposer: "ollama" = baseline LLaMA-3-8B via Ollama; "gen" = same prompt on Qwen3 server
export U1_DECOMPOSER=gen

# ---- caches on scratch (models are large)
export HF_HOME=/scratch/$USER/.cache/huggingface

# ---- set after the 'tune' stage
export K_REF=3
export K_TURN=5
